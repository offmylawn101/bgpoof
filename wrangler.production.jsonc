{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "removebg",
  "account_id": "78d07811c5de3b3b08e4e8b9a01301ec",
  "main": "dist/server/cloudflare-entry.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "images": { "binding": "IMAGES", "remote": true },
  "ratelimits": [
    {
      "name": "REMOVAL_LIMITER",
      "namespace_id": "2026091401",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "bgpoof.com", "custom_domain": true },
    { "pattern": "www.bgpoof.com", "custom_domain": true },
  ],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "observability": { "enabled": true },
}
