# Public build settings. Rebuild after changing these values.
# Leave empty during local development to avoid canonical redirects.
VITE_BGPOOF_SITE_URL=
# Optional Google Analytics measurement ID. Empty disables Google Analytics.
VITE_BGPOOF_GA_ID=
# Privacy disclosure only: set true if you enable Cloudflare Web Analytics
# separately in your Cloudflare account. This does not install its beacon.
VITE_BGPOOF_WEB_ANALYTICS=false
